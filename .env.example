# ====================================================================
# HealthPulse Frontend Environment Configuration
# ====================================================================
# Copy this file to '.env' and populate with your environment-specific values.

# --------------------------------------------------------------------
# 1. Backend REST API Base URL
# --------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000

# --------------------------------------------------------------------
# 2. Firebase Client Authentication (Web SDK)
# --------------------------------------------------------------------
# Obtain these values from:
# Firebase Console (https://console.firebase.google.com)
#   -> Project Settings (Gear Icon) -> General -> Your apps -> Web app (</>)
#   -> Firebase SDK snippet -> Config
#
# NOTE: If left empty or using placeholders during local evaluation,
# HealthPulse automatically operates in resilient development simulation mode.
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere123456
VITE_FIREBASE_AUTH_DOMAIN=healthpulse-hospital.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=healthpulse-hospital
VITE_FIREBASE_STORAGE_BUCKET=healthpulse-hospital.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
