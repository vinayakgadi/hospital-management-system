# ====================================================================
# HealthPulse Frontend Environment Configuration
# ====================================================================
# Copy this file to '.env' and populate with your environment-specific values.

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:5000

# --------------------------------------------------------------------
# Firebase Authentication Web SDK Configuration
# --------------------------------------------------------------------
# Retrieve these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=healthpulse-hospital
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
