# HealthPulse Database Configuration
# PostgreSQL connection string: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthpulse_db

# Flask Application Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=healthpulse-secure-secret-key-change-in-production
PORT=5000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
