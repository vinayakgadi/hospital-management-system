# ====================================================================
# HealthPulse Backend Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------------------
# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# If empty or unreachable, automatically falls back to local SQLite (backend/patients.db)
DATABASE_URL=postgresql://neondb_owner:npg_YaMrz8bSXiv4@ep-billowing-band-b54bdfgd-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --------------------------------------------------------------------
# 2. Flask Server Configuration
# --------------------------------------------------------------------
FLASK_APP=backend/app.py
FLASK_DEBUG=1
SECRET_KEY=healthpulse-secure-secret-key-change-in-production
PORT=5000

# --------------------------------------------------------------------
# 3. CORS Configuration
# --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------------------------------
# 4. Firebase Authentication Admin SDK Configuration
# --------------------------------------------------------------------
# Firebase Project ID (matches Firebase Console)
FIREBASE_PROJECT_ID=healthpulse-hospital

# Path to service account JSON file, or raw JSON string of service account key
# Download from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT_KEY=backend/service-account.json
