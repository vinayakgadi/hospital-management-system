# ====================================================================
# HealthPulse Backend Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------------------
# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# If empty or unreachable, automatically falls back to local SQLite (backend/patients.db)
DATABASE_URL=postgresql://neondb_owner:npg_YaMrz8bSXiv4@ep-billowing-band-b54bdfgd-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration
# --------------------------------------------------------------------
# Firebase Project ID (found in Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=healthpulse-hospital

# Optional path to Firebase Admin Service Account JSON certificate:
# e.g., backend/firebase-service-account.json or absolute path
# To obtain: Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
# SECURITY NOTICE: Never commit your service account JSON file to Git.
FIREBASE_SERVICE_ACCOUNT_KEY=backend/firebase-service-account.json

# --------------------------------------------------------------------
# 3. Flask Server Configuration
# --------------------------------------------------------------------
FLASK_APP=backend/app.py
FLASK_DEBUG=1
SECRET_KEY=healthpulse-secure-secret-key-change-in-production
PORT=5000

# --------------------------------------------------------------------
# 4. CORS Configuration
# --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
